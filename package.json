{
  "name": "kagi-shinobi",
  "version": "0.2.0-dev",
  "private": true,
  "description": "Cloudflare Worker fronting Kagi search + summarizer via session token, exposed as remote MCP and REST. Chrome-headers stealth. Auto token refresh via Browser Rendering.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "gen:kagi-types": "openapi-typescript https://kagi.redocly.app/openapi.yaml -o src/kagi/api/generated.d.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "agents": "^0.17.3",
    "cheerio": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.4",
    "@vitest/coverage-istanbul": "^4.1.10",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  }
}
