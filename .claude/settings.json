{
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm ci:*)",
      "Bash(npx vitest:*)",
      "Bash(npx tsc:*)",
      "Bash(npx wrangler types:*)",
      "Bash(npx wrangler deploy --dry-run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(npm publish:*)",
      "Read(./.dev.vars)",
      "Read(./.dev.vars.*)"
    ]
  }
}
